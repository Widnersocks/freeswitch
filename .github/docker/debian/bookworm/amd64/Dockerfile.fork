ARG BUILDER_IMAGE=debian:bookworm

FROM ${BUILDER_IMAGE} AS builder

ARG MAINTAINER_NAME="Meucci Fork"
ARG MAINTAINER_EMAIL="noreply@example.com"

ARG BUILD_NUMBER=42
ARG GIT_SHA=0000000000

ARG DATA_DIR=/data
ARG CODENAME=bookworm

LABEL maintainer="${MAINTAINER_NAME} <${MAINTAINER_EMAIL}>"

SHELL ["/bin/bash", "-c"]

# Install base build tooling
RUN apt-get -q update && \
    DEBIAN_FRONTEND=noninteractive apt-get -yq install \
        apt-transport-https \
        autoconf \
        automake \
        build-essential \
        ca-certificates \
        cmake \
        curl \
        debhelper \
        devscripts \
        dh-autoreconf \
        dos2unix \
        doxygen \
        git \
        graphviz \
        libglib2.0-dev \
        libssl-dev \
        libtiff-dev \
        libtool \
        lsb-release \
        pkg-config \
        python-is-python3 \
        wget

RUN update-ca-certificates --fresh

# Helper: build a .deb from a DESTDIR install
# Usage: build-lib-deb <pkgname> <version> <srcdir>
RUN printf '#!/bin/bash\nset -e\nPKG=$1 VER=$2 SRC=$3\n\
DEST=/tmp/deb-stage/${PKG}_${VER}_amd64\n\
mkdir -p "$DEST/DEBIAN"\n\
make -C "$SRC" DESTDIR="$DEST" install\n\
printf "Package: %s\\nVersion: %s\\nArchitecture: amd64\\nMaintainer: Fork\\nDescription: %s runtime library\\n" "$PKG" "$VER" "$PKG" > "$DEST/DEBIAN/control"\n\
dpkg-deb --build "$DEST" /tmp/lib-debs/\n\
rm -rf "$DEST"\n' > /usr/local/bin/build-lib-deb && chmod +x /usr/local/bin/build-lib-deb

RUN mkdir -p /tmp/lib-debs /tmp/deb-stage

# ── Build sofia-sip from source ──────────────────────────────────────────────
RUN git clone --depth 1 --branch v1.13.17 https://github.com/freeswitch/sofia-sip.git /tmp/sofia-sip \
    && cd /tmp/sofia-sip \
    && ./bootstrap.sh \
    && ./configure --prefix=/usr \
    && make -j$(nproc) \
    && make install \
    && ldconfig \
    && build-lib-deb libsofia-sip-fork 1.13.17 /tmp/sofia-sip \
    && rm -rf /tmp/sofia-sip

# ── Build spandsp from source ────────────────────────────────────────────────
RUN git clone --depth 1 https://github.com/freeswitch/spandsp.git /tmp/spandsp \
    && cd /tmp/spandsp \
    && ./bootstrap.sh \
    && ./configure --prefix=/usr \
    && make -j$(nproc) \
    && make install \
    && ldconfig \
    && build-lib-deb libspandsp-fork 3.0.0 /tmp/spandsp \
    && rm -rf /tmp/spandsp

# ── Build libilbc from source ────────────────────────────────────────────────
RUN git clone --depth 1 https://github.com/freeswitch/libilbc.git /tmp/libilbc \
    && cd /tmp/libilbc \
    && ./bootstrap.sh \
    && ./configure --prefix=/usr \
    && make -j$(nproc) \
    && make install \
    && ldconfig \
    && build-lib-deb libilbc-fork 3.0.0 /tmp/libilbc \
    && rm -rf /tmp/libilbc

RUN echo "export CODENAME=${CODENAME}" | tee ~/.env && \
    chmod +x ~/.env

RUN git config --global --add safe.directory '*' \
    && git config --global user.name "${MAINTAINER_NAME}" \
    && git config --global user.email "${MAINTAINER_EMAIL}"

# Bootstrap and Build
COPY . ${DATA_DIR}
WORKDIR ${DATA_DIR}
RUN echo "export VERSION=$(cat ./build/next-release.txt | tr -d '\n')" | tee -a ~/.env

# Remove modules whose deps aren't in standard Debian repos
RUN sed -i '/^Module: applications\/mod_signalwire$/,/^$/d' debian/control-modules && \
    sed -i '/^Module: codecs\/mod_bv$/,/^$/d' debian/control-modules && \
    sed -i '/^Module: codecs\/mod_silk$/,/^$/d' debian/control-modules && \
    sed -i '/^Module: languages\/mod_v8$/,/^$/d' debian/control-modules && \
    sed -i '/^Module: endpoints\/mod_verto$/,/^$/d' debian/control-modules

# Fix mod_spandsp for latest spandsp API (v18_init signature + renamed constants)
RUN sed -i 's/V18_MODE_5BIT_4545/V18_MODE_WEITBRECHT_5BIT_4545/g' src/mod/applications/mod_spandsp/mod_spandsp_dsp.c && \
    sed -i 's/V18_MODE_5BIT_50/V18_MODE_WEITBRECHT_5BIT_50/g' src/mod/applications/mod_spandsp/mod_spandsp_dsp.c && \
    sed -i 's/v18_init(NULL, TRUE, get_v18_mode(session), V18_AUTOMODING_GLOBAL, put_text_msg, NULL)/v18_init(NULL, TRUE, get_v18_mode(session), V18_AUTOMODING_GLOBAL, put_text_msg, NULL, NULL, NULL)/g' src/mod/applications/mod_spandsp/mod_spandsp_dsp.c && \
    sed -i 's/v18_init(NULL, FALSE, get_v18_mode(session), V18_AUTOMODING_GLOBAL, put_text_msg, pvt)/v18_init(NULL, FALSE, get_v18_mode(session), V18_AUTOMODING_GLOBAL, put_text_msg, pvt, NULL, NULL)/g' src/mod/applications/mod_spandsp/mod_spandsp_dsp.c

RUN . ~/.env && ./debian/util.sh prep-create-orig -n -V${VERSION}-${BUILD_NUMBER}-${GIT_SHA} -x
RUN . ~/.env && ./debian/util.sh prep-create-dsc ${CODENAME}

# Also strip excluded modules from modules_.conf (controls what configure builds)
RUN sed -i '/languages\/mod_v8/d' debian/modules_.conf && \
    sed -i '/applications\/mod_signalwire/d' debian/modules_.conf && \
    sed -i '/codecs\/mod_bv/d' debian/modules_.conf && \
    sed -i '/codecs\/mod_silk/d' debian/modules_.conf && \
    sed -i '/endpoints\/mod_verto/d' debian/modules_.conf

# Remove .install files for excluded modules so dh_install doesn't look for their .so files
RUN rm -f debian/freeswitch-mod-signalwire.install debian/freeswitch-mod-signalwire-dbg.* \
         debian/freeswitch-mod-bv.install debian/freeswitch-mod-bv-dbg.* \
         debian/freeswitch-mod-silk.install debian/freeswitch-mod-silk-dbg.* \
         debian/freeswitch-mod-v8.install debian/freeswitch-mod-v8-dbg.* \
         debian/freeswitch-mod-verto.install debian/freeswitch-mod-verto-dbg.*

# Strip libtpl-dev from Build-Depends (optional at configure time, not in Debian)
# and strip libldns-fs-dev alternative (libldns-dev in Debian will satisfy it)
RUN sed -i 's/ libtpl-dev (>= 1.5),//' debian/control && \
    sed -i 's/libldns-fs-dev | //' debian/control

# Install build deps directly — extract from debian/control Build-Depends,
# try each one, and skip any that aren't in Debian repos.
# Also create dummy debs for sofia-sip/spandsp (built from source above).
RUN apt-get --quiet update && \
    DEBIAN_FRONTEND=noninteractive apt-get -yq install equivs && \
    for pkg in libsofia-sip-ua-dev libsofia-sip-ua0 libspandsp3-dev libilbc-dev; do \
      printf 'Section: misc\nPriority: optional\nStandards-Version: 3.9.2\nPackage: %s\nVersion: 99.0.0\nDescription: dummy\n' "$pkg" > /tmp/${pkg}.ctl && \
      ( cd /tmp && equivs-build ${pkg}.ctl ) && \
      dpkg -i /tmp/${pkg}_99.0.0_all.deb ; \
    done && \
    sed -n '/^Build-Depends:/,/^[A-Z]/p' debian/control \
      | grep -v '^[A-Z]' \
      | tr ',' '\n' \
      | sed 's/([^)]*)//g; s/^[ \t]*//; s/[ \t]*$//' \
      | grep -v '^$' \
      | grep -v '^#' \
      | while IFS='|' read -ra alts; do \
          installed=false; \
          for alt in "${alts[@]}"; do \
            pkg=$(echo "$alt" | sed 's/^[ \t]*//; s/[ \t]*$//'); \
            [ -z "$pkg" ] && continue; \
            echo "Trying: $pkg" && \
            DEBIAN_FRONTEND=noninteractive apt-get -yq --no-install-recommends install "$pkg" 2>/dev/null \
              && installed=true && break; \
          done; \
          [ "$installed" = false ] && echo "SKIPPED (no alternative available): ${alts[*]}"; \
          true; \
        done && \
    apt-get --yes --fix-broken install

# Allow dpkg-shlibdeps to proceed even when libs were installed from source (no .deb metadata)
RUN printf '\noverride_dh_shlibdeps:\n\tdh_shlibdeps --dpkg-shlibdeps-params=--ignore-missing-info\n' >> debian/rules

ENV DEB_BUILD_OPTIONS="parallel=$(nproc)"
RUN . ~/.env && dch -b -M -v "${VERSION}-${BUILD_NUMBER}-${GIT_SHA}~${CODENAME}" \
  --force-distribution -D "${CODENAME}" "Fork build, ${GIT_SHA}"

RUN . ~/.env && ./debian/util.sh create-orig -n -V${VERSION}-${BUILD_NUMBER}-${GIT_SHA} -x

RUN dpkg-source \
        --diff-ignore=.* \
        --compression=xz \
        --compression-level=9 \
        --build \
    . \
    && debuild -b -d -us -uc \
    && mkdir OUT \
    && mv -v ../*.{deb,dsc,changes,tar.*} OUT/. \
    && cp -v /tmp/lib-debs/*.deb OUT/.

RUN ls -lah /data/OUT

# Artifacts image (mandatory part, the resulting image must have a single filesystem layer)
FROM scratch
COPY --from=builder /data/OUT/ /
